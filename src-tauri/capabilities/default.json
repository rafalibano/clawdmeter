{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Popover window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "fs:scope",
      "deny": [{ "path": "$APPDATA/.migration" }, { "path": "$APPDATA/.migration/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPCONFIG" }, { "path": "$APPCONFIG/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPCONFIG" }, { "path": "$APPCONFIG/**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPCONFIG/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPCONFIG/**" }]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [{ "path": "$APPCONFIG/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPCONFIG/usage-history.json" }, { "path": "$APPCONFIG/usage-history.*.json" }]
    },
    {
      "identifier": "fs:allow-watch",
      "allow": [{ "path": "$APPCONFIG" }, { "path": "$APPCONFIG/**" }]
    },
    "fs:allow-unwatch",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$HOME/.claude/sessions" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$HOME/.claude/sessions" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$HOME/.claude/sessions/*.json" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$HOME/.config/claude-usage-bar/history.json" }]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [{ "path": "$HOME/.config/claude-usage-bar/history.json" }]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.github.com/*" },
        { "url": "https://github.com/login/*" },
        { "url": "https://login.microsoftonline.com/*" },
        { "url": "https://graph.microsoft.com/*" }
      ]
    },
    "notification:allow-is-permission-granted",
    "notification:allow-notify",
    "notification:allow-request-permission",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-claude-oauth-begin",
    "allow-claude-oauth-complete",
    "allow-claude-oauth-cancel",
    "allow-claude-account-status",
    "allow-claude-account-remove",
    "allow-claude-usage-fetch",
    "allow-process-run",
    "allow-process-spawn",
    "allow-process-kill",
    "allow-process-is-alive",
    "allow-oauth-loopback-listen",
    "allow-oauth-loopback-wait",
    "allow-oauth-loopback-cancel",
    "allow-terminal-run",
    "allow-open-url",
    "allow-open-system-settings",
    "allow-notification-permission-state",
    "allow-launch-at-login-status",
    "allow-launch-at-login-enable",
    "allow-launch-at-login-disable",
    "allow-tray-set-usage",
    "allow-updater-check",
    "allow-updater-install",
    "allow-updater-restart"
  ]
}
